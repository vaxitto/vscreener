{
  "manifest_version": 3,
  "name": "Full Page Fluent Capture",
  "description": "Capture full-page screenshots with fluent dark UI and optional compression.",
  "version": "1.0.0",
  "action": {
    "default_title": "Full Page Fluent Capture",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "downloads",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
